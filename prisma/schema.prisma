generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SellerAccount {
  id           String   @id @default(uuid()) @db.Uuid
  sellerName   String
  email        String   @unique
  passwordHash String
  plan         String   @default("FREE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile     SellerProfile?
  orderConfig SellerOrderConfig?
  sessions    AuthSession[]
  publicLinks PublicOrderLink[]

  @@map("seller_accounts")
  @@index([createdAt], map: "idx_seller_accounts_created_at")
}

model SellerProfile {
  sellerId               String   @id @db.Uuid
  storeName              String
  storeSlug              String   @unique
  destinationPhoneNumber String
  storeDescription       String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  seller SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("seller_profiles")
  @@index([storeName], map: "idx_seller_profiles_store_name")
  @@index([storeSlug], map: "idx_seller_profiles_store_slug")
}

model SellerOrderConfig {
  sellerId        String   @id @db.Uuid
  openingText     String
  closingText     String
  showPhoneNumber Boolean  @default(true)
  showAddress     Boolean  @default(true)
  showNote        Boolean  @default(true)
  customFields    Json     @default("[]")
  fieldOrder      Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seller SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("seller_order_configs")
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  sellerId  String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  seller SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("auth_sessions")
  @@index([sellerId], map: "idx_auth_sessions_seller_id")
  @@index([expiresAt], map: "idx_auth_sessions_expires_at")
}

model PublicOrderLink {
  id                 String   @id @default(uuid()) @db.Uuid
  token              String   @unique
  sellerId           String   @db.Uuid
  configSnapshotJson Json
  isActive           Boolean  @default(true)
  expiresAt          DateTime?
  createdAt          DateTime @default(now())

  seller SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("public_order_links")
  @@index([sellerId], map: "idx_public_order_links_seller_id")
  @@index([sellerId, isActive], map: "idx_public_order_links_seller_active")
}
